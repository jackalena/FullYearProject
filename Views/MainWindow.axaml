<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        xmlns:vm="using:FullYearProject.ViewModels"
        xmlns:views="using:FullYearProject.Views"
        d:DesignHeight="450" d:DesignWidth="800" MinHeight="350" MinWidth="600"
        x:Class="FullYearProject.Views.MainWindow" x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico" Title="FullYearProject">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <views:HeaderView DockPanel.Dock="Top" />

        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Left" Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="15" IsVisible="{Binding ShowTimer}">
            <LucideIcon Kind="Hourglass" Size="20">
                <LucideIcon.Styles>
                    <Style Selector="LucideIcon">
                        <Setter Property="RotateTransform.Angle" Value="0" />

                        <Style Selector="^.ShakeEffect">
                            <Style.Animations>
                                <Animation Duration="0:0:0.5" IterationCount="INFINITE"
                                           PlaybackDirection="Alternate"
                                           Easing="SineEaseInOut">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="RotateTransform.Angle" Value="15" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="RotateTransform.Angle" Value="-15" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Style>
                </LucideIcon.Styles>
            </LucideIcon>
            <TextBlock Margin="5 0">
                <Run Text="{Binding TimeRemaining, StringFormat='m\\:ss'}" />
                <Run Text="remaining" />
            </TextBlock>
        </StackPanel>

        <TransitioningContentControl Content="{Binding CurrentViewModel}">
            <TransitioningContentControl.PageTransition>
                <PageSlide Duration="0:0:0.5" SlideInEasing="CubicEaseInOut" SlideOutEasing="CubicEaseInOut" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </DockPanel>


</Window>
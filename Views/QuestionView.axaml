<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:FullYearProject.Views"
             xmlns:models="clr-namespace:FullYearProject.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FullYearProject.Views.QuestionView">

    <UserControl.Styles>
        <StyleInclude Source="Styles.axaml" />
    </UserControl.Styles>

    <Design.DesignStyle>
        <Style Selector="views|QuestionView">
            <Setter Property="Question" Value="What is the answer to this question?" />
            <Setter Property="Image" Value="/Assets/placeholder.png" />
            <Setter Property="AnswerOptions">
                <models:StringCollection>
                    <x:String>Option 1</x:String>
                    <x:String>Option 2</x:String>
                    <x:String>Option 3</x:String>
                    <x:String>Option 4</x:String>
                </models:StringCollection>
            </Setter>
        </Style>
    </Design.DesignStyle>

    <Grid RowDefinitions="2* 3* Auto">
        <Border Classes="Light2Shadow CardFlat" Padding="13" Margin="20 20 20 0">
            <DockPanel>
                <Border CornerRadius="7" ClipToBounds="True" VerticalAlignment="Center" Margin="0" Padding="0"
                        Classes="CardFlat" DockPanel.Dock="Right">
                    <Image Source="{Binding $parent[views:QuestionView].Image}"
                           RenderOptions.BitmapInterpolationMode="MediumQuality" Stretch="Uniform" />
                </Border>
                <TextBlock Classes="H1" Text="{Binding $parent[views:QuestionView].Question}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ContentPresenter Grid.Row="1" Content="{Binding $parent[views:QuestionView].Child}"
                          Margin="10 10 10 0"
                          IsVisible="{Binding $parent[views:QuestionView].Child, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ItemsControl
            IsVisible="{Binding $parent[views:QuestionView].Child, Converter={x:Static ObjectConverters.IsNull}}"
            ItemsSource="{Binding $parent[views:QuestionView].AnswerOptions}" Grid.Row="1"
            PreparingContainer="AnswerOptionsItemsControl_OnPreparingContainer">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" Margin="15 5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Classes="Answer" Margin="5" Content="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <Button Grid.Row="2" Margin="10 0 10 10" HorizontalAlignment="Right"
                Theme="{DynamicResource BorderlessButton}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Skip" VerticalAlignment="Center" />
                <LucideIcon Kind="ChevronLast" VerticalAlignment="Center" Size="22" Margin="0 4 0 3" />
            </StackPanel>
        </Button>

        <StackPanel Grid.Row="2" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="20 0 0 0">
            <LucideIcon Kind="Hourglass" Size="20">
                <LucideIcon.Styles>
                    <Style Selector="LucideIcon">
                        <Setter Property="RotateTransform.Angle" Value="0" />

                        <Style Selector="^.ShakeEffect">
                            <Style.Animations>
                                <Animation Duration="0:0:0.5" IterationCount="INFINITE"
                                           PlaybackDirection="Alternate"
                                           Easing="SineEaseInOut">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="RotateTransform.Angle" Value="15" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="RotateTransform.Angle" Value="-15" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Style>
                </LucideIcon.Styles>
            </LucideIcon>
            <TextBlock Margin="5 0" Text="5:00 remaining" />
        </StackPanel>
    </Grid>
</UserControl>
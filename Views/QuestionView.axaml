<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:FullYearProject.Models"
             xmlns:vm="clr-namespace:FullYearProject.ViewModels"
             xmlns:views="clr-namespace:FullYearProject.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:QuestionViewModel"
             x:Class="FullYearProject.Views.QuestionView">

    <Design.DataContext>
        <vm:QuestionViewModel Quiz="{x:Static models:DesignQuiz.Quiz}" Question="{x:Static models:DesignQuiz.Question}">
            <vm:QuestionViewModel.Timer>
                <models:TimeRemainingProvider StartTime="0:1:0" AutoStart="True" />
            </vm:QuestionViewModel.Timer>
        </vm:QuestionViewModel>
    </Design.DataContext>

    <UserControl.Styles>
        <StyleInclude Source="Styles.axaml" />
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="2* 3* Auto" IsVisible="{Binding !ShowCompleted}">
            <Border Classes="Light2Shadow CardFlat" Padding="13" Margin="20 20 20 0">
                <DockPanel>
                    <Border CornerRadius="7" ClipToBounds="True" VerticalAlignment="Center" Margin="0" Padding="0"
                            Classes="CardFlat" DockPanel.Dock="Right">
                        <Image Source="{Binding QuestionImage}"
                               RenderOptions.BitmapInterpolationMode="MediumQuality" Stretch="Uniform" />
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Classes="H0" Text="{Binding QuestionTopic}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <TextBlock Classes="H1" Text="{Binding QuestionText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- <ContentPresenter Grid.Row="1" Content="{Binding $parent[views:QuestionView].Child}" -->
            <!--                   Margin="10 10 10 0" -->
            <!--                   IsVisible="{Binding $parent[views:QuestionView].Child, Converter={x:Static ObjectConverters.IsNotNull}}" /> -->

            <ItemsControl
                ItemsSource="{Binding QuestionOptions}" Grid.Row="1"
                PreparingContainer="AnswerOptionsItemsControl_OnPreparingContainer">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Margin="15 5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="Answer" Margin="5" Content="{Binding}"
                                Command="{Binding $parent[views:QuestionView].((vm:QuestionViewModel)DataContext).AnswerButtonPressedCommand, FallbackValue={x:Null}}"
                                CommandParameter="{Binding }" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <Button Grid.Row="2" Margin="10 0 10 10" HorizontalAlignment="Right"
                    Theme="{DynamicResource BorderlessButton}" Command="{Binding SkipButtonPressedCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Skip" VerticalAlignment="Center" />
                    <LucideIcon Kind="ChevronLast" VerticalAlignment="Center" Size="22" Margin="0 4 0 3" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Row="2" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="20 0 0 0">
                <LucideIcon Kind="Hourglass" Size="20">
                    <LucideIcon.Styles>
                        <Style Selector="LucideIcon">
                            <Setter Property="RotateTransform.Angle" Value="0" />

                            <Style Selector="^.ShakeEffect">
                                <Style.Animations>
                                    <Animation Duration="0:0:0.5" IterationCount="INFINITE"
                                               PlaybackDirection="Alternate"
                                               Easing="SineEaseInOut">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="RotateTransform.Angle" Value="15" />
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="RotateTransform.Angle" Value="-15" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Style>
                    </LucideIcon.Styles>
                </LucideIcon>
                <TextBlock Margin="5 0">
                    <Run Text="{Binding TimeRemaining, StringFormat='m\\:ss'}" />
                    <Run Text="remaining" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <Button Name="OverlayBorder" IsVisible="{Binding ShowCompleted}" Padding="20"
                Classes.Incorrect="{Binding !IsCorrect}" HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">


            <Button.Styles>
                <Style Selector="Button#OverlayBorder">
                    <Setter Property="Background" Value="#598937" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="White" />

                    <Style Selector="^:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#598937" />
                    </Style>
                    <Style Selector="^:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="#598937" />
                    </Style>

                    <Style Selector="^.Incorrect">
                        <Setter Property="Background" Value="#B03030" />

                        <Style Selector="^:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#B03030" />
                        </Style>
                        <Style Selector="^:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="#B03030" />
                        </Style>
                    </Style>
                </Style>
            </Button.Styles>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="H1" Text="{Binding QuestionText}" HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <StackPanel Orientation="Horizontal"
                            IsVisible="{Binding SelectedOption, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <LucideIcon Kind="X" />
                    <TextBlock Text="{Binding SelectedOption.Value, FallbackValue=''}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <LucideIcon Kind="Check" />
                    <TextBlock Text="{Binding CorrectOption.Value}" />
                </StackPanel>


            </StackPanel>
        </Button>
    </Panel>
</UserControl>
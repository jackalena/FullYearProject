<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FullYearProject.ViewModels"
             xmlns:views="clr-namespace:FullYearProject.Views"
             xmlns:markdownTextBlock="clr-namespace:FullYearProject.Controls.MarkdownTextBlock"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:QuestionViewModel"
             x:Class="FullYearProject.Views.QuestionView">

    <UserControl.Styles>
        <StyleInclude Source="Styles.axaml" />
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="2* 3* Auto">
            <Border Classes="Light2Shadow CardFlat" Padding="18 13" Margin="20 20 20 0">
                <DockPanel>
                    <markdownTextBlock:MarkdownTextBlock DockPanel.Dock="Top" Classes="H0" FontSize="24"
                                                         Text="{Binding TopicName}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <markdownTextBlock:MarkdownTextBlock Classes="H1" Text="{Binding Question.Text}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Question.Options}" Grid.Row="1"
                          PreparingContainer="AnswerOptionsItemsControl_OnPreparingContainer">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Margin="15 5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="Answer" Margin="5"
                                Command="{Binding $parent[views:QuestionView].((vm:QuestionViewModel)DataContext).AnswerButtonPressedCommand}"
                                CommandParameter="{Binding }">

                            <markdownTextBlock:MarkdownTextBlock Text="{Binding Value}" Classes="H2" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <Button Grid.Row="2" Margin="10 0 10 10" HorizontalAlignment="Right"
                    Theme="{DynamicResource BorderlessButton}" Command="{Binding SkipButtonPressedCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Skip" VerticalAlignment="Center" />
                    <LucideIcon Kind="ChevronLast" VerticalAlignment="Center" Size="22" Margin="0 4 0 3" />
                </StackPanel>
            </Button>
        </Grid>

        <Button Name="OverlayBorder" Classes.Hidden="{Binding !ShowCompleted}" Padding="20"
                Classes.Incorrect="{Binding IsIncorrect}" HorizontalAlignment="Stretch"
                Classes.Skipped="{Binding IsSkipped}" VerticalAlignment="Stretch" Margin="20" CornerRadius="10"
                Command="{Binding SkipCompletedCommand}">

            <Button.Styles>
                <Style Selector="Button#OverlayBorder">
                    <Setter Property="Background" Value="#598937" />
                    <Setter Property="BorderBrush" Value="#7FA95E" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="IsVisible" Value="True" />
                    <Setter Property="RenderTransform" Value="scale(1.0)" />
                    <Setter Property="RenderTransformOrigin" Value="50%, 50%" />
                    <Setter Property="Opacity" Value="1.0" />

                    <Setter Property="Transitions">
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3"
                                                           Easing="CubicEaseOut" />
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                        </Transitions>
                    </Setter>

                    <Style Selector="^:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#598937" />
                        <Setter Property="BorderBrush" Value="#7FA95E" />
                    </Style>
                    <Style Selector="^:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="#598937" />

                        <Setter Property="BorderBrush" Value="#7FA95E" />
                    </Style>

                    <Style Selector="^.Incorrect">
                        <Setter Property="Background" Value="#B03030" />
                        <Setter Property="BorderBrush" Value="#C74D4D" />

                        <Style Selector="^:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#B03030" />
                            <Setter Property="BorderBrush" Value="#C74D4D" />
                        </Style>
                        <Style Selector="^:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="#B03030" />
                            <Setter Property="BorderBrush" Value="#C74D4D" />
                        </Style>
                    </Style>

                    <Style Selector="^.Skipped">
                        <Setter Property="Background" Value="#B06320" />
                        <Setter Property="BorderBrush" Value="#C4834C" />

                        <Style Selector="^:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#B06320" />
                            <Setter Property="BorderBrush" Value="#C4834C" />
                        </Style>
                        <Style Selector="^:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="#B06320" />
                            <Setter Property="BorderBrush" Value="#C4834C" />
                        </Style>
                    </Style>

                    <Style Selector="^.Hidden">
                        <Setter Property="IsVisible" Value="False" />
                        <Setter Property="RenderTransform" Value="scale(0.0)" />
                        <Setter Property="Opacity" Value="0.0" />
                    </Style>
                </Style>
            </Button.Styles>

            <DockPanel>
                <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Classes="H0" Text="Correct!"
                           IsVisible="{Binding IsCorrect}" />
                <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Classes="H0" Text="Incorrect"
                           IsVisible="{Binding IsIncorrect}" />
                <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Classes="H0" Text="Question Skipped"
                           IsVisible="{Binding IsSkipped}" />

                <TextBlock DockPanel.Dock="Bottom" Text="Click to continue" FontStyle="Italic"
                           HorizontalAlignment="Center"
                           Margin="10" />

                <StackPanel VerticalAlignment="Center" Spacing="10">
                    <markdownTextBlock:MarkdownTextBlock Classes="H1" Text="{Binding Question.Text}"
                                                         HorizontalAlignment="Center"
                                                         HorizontalContentAlignment="Center" Margin="0 0 0 20" />

                    <StackPanel Orientation="Horizontal" Spacing="10"
                                IsVisible="{Binding IsIncorrect}" HorizontalAlignment="Center">
                        <LucideIcon Kind="X" />
                        <markdownTextBlock:MarkdownTextBlock
                            Text="{Binding SelectedOption.Value, FallbackValue='', TargetNullValue=''}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <LucideIcon Kind="Check" />
                        <markdownTextBlock:MarkdownTextBlock
                            Text="{Binding CorrectOption.Value, FallbackValue='No correct option'}" />
                    </StackPanel>

                    <markdownTextBlock:MarkdownTextBlock Margin="0 10 0 0" Text="{Binding Question.Explanation}" />
                </StackPanel>
            </DockPanel>
        </Button>
    </Panel>
</UserControl>